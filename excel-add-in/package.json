{
  "name": "excel-add-in",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/ExtraBB/Office-Addin-React-Vite-Template.git"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_port": 1420
  },
  "scripts": {
    "build": "tsc && vite build && npm run validate",
    "dev": "vite --port 1420",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prettier": "office-addin-lint prettier",
    "preview": "vite preview",
    "start": "office-addin-debugging start dist/manifest.xml",
    "start:desktop": "office-addin-debugging start dist/manifest.xml desktop",
    "start:web": "office-addin-debugging start dist/manifest.xml web",
    "stop": "office-addin-debugging stop dist/manifest.xml",
    "validate": "office-addin-manifest validate dist/manifest.xml",
    "generate": "python ./src/functions/generator/ts_generator.py",
    "generate:update": "python ./src/functions/generator/ts_generator.py --update",
    "office:clear-mac": "rm -rf ~/Library/Containers/com.microsoft.Excel",
    "office:tools-mac": "defaults write com.microsoft.Excel OfficeWebAddinDeveloperExtras -bool true",
    "test": "jest --silent --verbose",
    "test:unit": "jest --silent --verbose --selectProjects=unit",
    "test:integration-full": "jest --silent --verbose --selectProjects=integration-full",
    "test:integration-smoke": "jest --silent --verbose --selectProjects=integration-smoke"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.1",
    "@openbb/ui": "^0.3.0",
    "@radix-ui/react-tooltip": "^1.2.7",
    "axios": "^1.5.0",
    "class-variance-authority": "^0.7.0",
    "dayjs": "^1.11.13",
    "dayjs-business-days2": "^1.3.0",
    "mdx-bundler": "^9.2.1",
    "moment-timezone": "^0.5.43",
    "posthog-js": "^1.164.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.46.1",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.15.0",
    "tailwind-merge": "^1.14.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.2",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.22.15",
    "@babel/preset-react": "^7.22.15",
    "@prettier/plugin-xml": "^3.2.0",
    "@types/custom-functions-runtime": "^1.6.6",
    "@types/jest": "^29.5.5",
    "@types/office-js": "^1.0.342",
    "@types/office-runtime": "^1.0.33",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.6.0",
    "@typescript-eslint/parser": "^6.6.0",
    "@vitejs/plugin-react-swc": "^3.3.2",
    "autoprefixer": "^10.4.15",
    "custom-functions-metadata": "^1.5.2",
    "eslint": "^8.49.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "eslint-plugin-unused-imports": "^3.0.0",
    "office-addin-cli": "^1.5.7",
    "office-addin-debugging": "^5.0.12",
    "office-addin-dev-certs": "^1.11.6",
    "office-addin-manifest": "^1.12.7",
    "office-addin-mock": "^2.3.14",
    "office-addin-prettier-config": "^1.2.0",
    "prettier": "^3.0.3",
    "prettier-plugin-organize-imports": "^3.2.3",
    "prettier-plugin-tailwindcss": "^0.5.4",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "vite": "^4.4.9",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-markdown": "^2.2.0-2",
    "vite-plugin-office-addin": "^1.0.0"
  }
}
