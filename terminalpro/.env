# OpenBB Workspace Environment Configuration
# ⚠️ ALL THESE VARIABLES ARE PUBLIC AND SHOULD NOT BE USED FOR SENSITIVE INFORMATION ⚠️

# URLs
# URL where Backend of OpenBB Workspace is hosted
# set this to "/api" if its snowflake internal app
VITE_PAYMENTS_URL="https://backend.openbb.dev"
# VITE_PAYMENTS_URL="http://localhost:8000"
# URL where AI Backend for OpenBB Agent is hosted
VITE_AI_API_URL="https://ai.openbb.dev"
# VITE_AI_API_URL="http://localhost:7779"
# URL where Platform Backend is hosted, used to fetch data from Platform on prod/dev, all auto generated fetchers on src\lib\api\sdkFetcher.ts will use this URL
VITE_PLATFORM_URL="https://sdk.openbb.dev"
# Excel add-in enabled (Excel formula in AgGrid table widgets and Export to Excel functionality)
VITE_EXCEL_ADD_IN_ENABLED="true"
# Is the app running inside Snowflake Native App
VITE_SNOWFLAKE_NATIVE_APP="false"

# Configuration
# Required to use Google Auth, defined for pro.openbb.co, pro.openbb.dev and http://localhost:1420
VITE_GOOGLE_OAUTH_CLIENT_ID="508662717287-ls9frq1ohf1tvug8vm91ofhmbraiuegu.apps.googleusercontent.com"
# Required to use Microsoft Auth
VITE_AZURE_CLIENT_ID="287dfc81-c4ac-4093-b77d-8cd00d1c0a55"
VITE_AZURE_TENANT_ID="fd311a04-857a-46aa-82f3-52a928acad01"
# Required to use Okta Auth
VITE_OKTA_CLIENT_ID=""
VITE_OKTA_DOMAIN=""
# PostHog analytics configuration
# Key for interaction with PostHog created in https://us.posthog.com/
VITE_POSTHOG_KEY="phc_qgW2kepNXdY7q1ZIuV2RT5WFXRDcTCkYlB66ukrOH30"
# Proxy URL for PostHog
VITE_POSTHOG_URL="https://info.openbb.dev"
# Enable react-scan for Render Scanning (catch performance issues when developing) - https://github.com/aidenybai/react-scan
VITE_ENABLE_RENDER_SCANNING="false"

# Versioning
# Current version of the app, used for changelog, versioning and to display on bottom in left sidebar
VITE_RELEASE_VERSION="v7.8.20"
# Minimum version of Data Connector required to use the app
VITE_DATA_CONNECTOR_MIN_VERSION="0.1.1"

# Tests configuration
# Playwright testing credentials
VITE_PLAYWRIGHT_ACCOUNT_USERNAME=
VITE_PLAYWRIGHT_ACCOUNT_PASSWORD=
VITE_PLAYWRIGHT_ACCOUNT_EMAIL=
VITE_PLAYWRIGHT_TEST_KEY=
# Environment where the tests are running, can be dev or prod
VITE_ENVIRONMENT="dev"



# Flags to enable/disable features
# https://openbb.atlassian.net/wiki/spaces/ENG/pages/912130094/RFC+On+Prem+Deployment+-+Turning+Feature+Configurations+on+off?focusedCommentId=957808647

# authentication
# authentication - allow_email_login - Controls whether users can login with their email - If false, hides email login button/page
VITE_AUTHENTICATION_ALLOW_EMAIL_LOGIN="true"
# authentication - allow_registration - Controls whether users can register themselves - If false, hides registration link/page
VITE_AUTHENTICATION_ALLOW_REGISTRATION="false"
# authentication - allow_forgot_password - Controls whether the "forgot password" flow is enabled - If false, hides forgot password link/page; if email is off, page instructs "contact admin"
VITE_AUTHENTICATION_ALLOW_FORGOT_PASSWORD="true"
# authentication - identity_providers - A list of enabled external identity providers - Shows/hides external login buttons based on this list
# comma separated list of available providers: google,microsoft,okta
# empty for none
VITE_AUTHENTICATION_IDENTITY_PROVIDERS="google"
# send microsoft idToken to custom backend
VITE_AUTHENTICATION_SEND_MICROSOFT_IDTOKEN="false"
# send okta idToken to custom backend
VITE_AUTHENTICATION_SEND_OKTA_IDTOKEN="false"
# send user email as header to custom backend
VITE_AUTHENTICATION_SEND_USER_EMAIL_AS_HEADER="true"

# copilot
# ai_copilot - enabled - Master switch for entire Copilot feature - If false, hides copilot panel, add-to-copilot button, AI enhancements in settings, no copilot UI elements
VITE_AI_COPILOT_ENABLED="true"
# ai_copilot - openbb_copilot - Controls whether OpenBB Copilot itself is enabled - If false, hides OpenBB Copilot UI elements and AI enhancements, no widget/file name generation UI - No OpenBB Copilot-specific endpoints called if false
VITE_AI_COPILOT_OPENBB_COPILOT="true"
# ai_copilot - documentation_links - Controls visibility of Copilot documentation links and tooltips - If false, doc links and instructions hidden - No application backend impact - No direct copilot backend impact - Must be false if openbb_copilot is false
VITE_AI_COPILOT_DOCUMENTATION_LINKS="true"
# ai_copilot - web_search - Controls whether Copilot's web search (Perplexity) is enabled - If false, hides @web shortcut and hints, no calls to Perplexity API
VITE_AI_COPILOT_WEB_SEARCH="true"
# ai_copilot - sec_filings - Controls whether Copilot's SEC filings retrieval is enabled - If false, hides @sec shortcut and hints, no calls to SEC filings API
VITE_AI_COPILOT_SEC_FILINGS="false"
# ai_copilot - jina_ai - Toggles HTML-to-Markdown parsing - If false, "add to copilot context" button hidden on iframes, no calls to Jina AI
VITE_AI_COPILOT_JINA_AI="true"
# ai_copilot - ai_enhancements - Controls AI-based UI enhancements (e.g., widget names) - If false, AI enhancements in user settings hidden; no name generation UI
VITE_AI_COPILOT_AI_ENHANCEMENTS="true"
# ai_copilot - save_skill_from_chat - Allows the copilot to save the current chat as a skill via the save_skill function call - If false, the call is rejected client-side and no conversation is sent to the AI service
VITE_AI_COPILOT_SAVE_SKILL_FROM_CHAT="true"
# ai_copilot - show in the UI popup to add custom key
VITE_AI_SHOW_CUSTOM_COPILOT_KEY="true"

# ui
# ui - show_companion_mode - Toggles MCP Companion entry in the hamburger menu - If false, the menu item is hidden so users cannot open the MCP Companion modal - No application backend impact - No copilot backend impact
VITE_UI_SHOW_COMPANION_MCP_MODE="true"
# ui - show_minimize_widget - Toggles widget minimize/expand functionality - If false, minimize button setting is hidden - No application backend impact - No copilot backend impact
VITE_UI_SHOW_MINIMIZE_WIDGET="true"
# ui - show_chart_generation - Toggles chart generation from table data selection - If false, chart generation button setting is hidden - No application backend impact - No copilot backend impact
VITE_UI_SHOW_CHART_GENERATION="true"
# ui - show_feedback_button - Toggles "Submit Feedback" button - If false, feedback button and form route hidden - No application backend impact - No copilot backend impact - Must be false if services.hubspot_forms is false
VITE_UI_SHOW_FEEDBACK_BUTTON="true"
# ui - show_invite_button - Toggles "Invite Colleagues" button - If false, invite button and route hidden - No application backend impact - No copilot backend impact
VITE_UI_SHOW_INVITE_BUTTON="true"
# ui - show_demo_request_button - Toggles "Request a Demo" button - If false, demo request button and route hidden - No application backend impact - No copilot backend impact - Must be false if services.hubspot_forms is false
VITE_UI_SHOW_DEMO_REQUEST_BUTTON="true"
# ui - show_enterprise_tags - Toggles enterprise tags and labels - If false, enterprise/pro tags hidden - No application backend impact - No copilot backend impact
VITE_UI_SHOW_ENTERPRISE_TAGS="true"
# ui - show_external_documentation_links - Toggles external documentation links - If false, external doc links hidden - No application backend impact - No copilot backend impact
VITE_UI_SHOW_EXTERNAL_DOCUMENTATION_LINKS="true"
# ui - show_help_documentation - Toggles in-app help and documentation references - If false, help/docs menu items and route hidden - No application backend impact - No copilot backend impact
VITE_UI_SHOW_HELP_DOCUMENTATION="true"
# ui - show_changelog - Toggles changelog button - If false, changelog button hidden and dialog hidden - No application backend impact - No copilot backend impact
VITE_UI_SHOW_CHANGELOG="true"
# ui - show onboarding questions - Toggles onboarding questions - If false, onboarding questions hidden - No application backend impact - No copilot backend impact
VITE_UI_SHOW_ONBOARDING_QUESTIONS="true"
# ui - show_tos - Toggles terms and conditions - If false, terms and conditions hidden - No application backend impact - No copilot backend impact
VITE_UI_SHOW_TOS="true"
# ui - show_copilot_switcher - Toggles copilot switcher - If false, copilot switcher hidden - No application backend impact - No copilot backend impact
VITE_UI_SHOW_COPILOT_SWITCHER="true"
# ui - show_remove_from_org - Toggles remove from organization button - If false, remove from organization button hidden - No application backend impact - No copilot backend impact
VITE_UI_SHOW_REMOVE_FROM_ORG="true"
# ui - chart generation from table cell limit to prevent crashes with large datasets
VITE_CHART_FROM_TABLE_CELL_LIMIT=200000
# ui - default theme - Sets the default theme for the application - can be either "light" or "dark"
VITE_UI_DEFAULT_THEME="dark"
# ui - show Open Data Platform download installer option in settings menu
VITE_UI_ODP_DOWNLOAD_INSTALLER="true"
# show contact sales @openbb.co or show contact admin
VITE_UI_SHOW_SALES_EMAIL="true"
# ui - is_lite - Lite deployment: App Marketplace is browse-only; the Connect CTA is replaced by "Contact Vendor"
VITE_LITE="false"
# ui - show_marketplace - Toggles the App Marketplace tab - If false, the marketplace is hidden (e.g. to hide it on lite/on-prem)
VITE_UI_SHOW_MARKETPLACE="true"


# allow_html_js_execution - Toggles HTML/JS execution - If false, JS execution in HTML widget is disabled
VITE_ALLOW_HTML_JS_EXECUTION="true"

# data
# data - package_data_enabled - Toggles packaged data tab - If false, packaged data tab hidden - Possibly no packaged data calls from application backend - No copilot backend impact
VITE_DATA_PACKAGE_DATA_ENABLED="true"
# data - allowed_data_vendors - Controls which external data vendors are shown and allowed - Only listed vendors shown in UI - Restricts vendor API calls to listed vendors - No copilot backend impact - If empty, no external vendors shown
# comma separated list of available vendors (list of ids from src/lib/widget_bundles.json): fmp,benzinga,econdb,pyth,tradingview,intrinio,tradingeconomics
# empty for none
VITE_DATA_ALLOWED_DATA_VENDORS="fmp,benzinga,econdb,pyth,tradingview"
# data - allowed_db_types - Controls which database connection types are allowed - Shows only allowed DB types in add data modal - Restricts DB connection attempts in application backend - No copilot backend impact - If empty, no DB connections allowed
# comma separated list of available database types: database,snowflake,databricks,clickhouse
# empty for none
VITE_DATA_ALLOWED_DB_TYPES="database,snowflake,databricks,clickhouse"
# open data platform installer packages
VITE_OPEN_DATA_PLATFORM_INSTALLER_ENABLED="true"

# mcp
# mcp - default_server - Adds OpenBB Docs MCP server by default for new users - If false, users must manually add MCP servers
VITE_MCP_DEFAULT_SERVER_ENABLED="true"

# services
# services - posthog - Toggles product analytics (Posthog) - No UI changes except not tracking actions - No Posthog calls from application backend if false - No copilot backend impact
VITE_SERVICES_POSTHOG="false"
# services - hubspot_forms - Toggles Hubspot forms and transactional emails - If false, no Hubspot-based forms (feedback/demo), no Hubspot-driven invites or password resets - No Hubspot calls from application backend - No copilot backend impact - If false, show_feedback_button & show_demo_request_button should be false
VITE_SERVICES_HUBSPOT_FORMS="true"
# services - email - Toggles direct outbound email sending - If false, no direct email sending; forgot password instructs "contact admin" if also no Hubspot - No direct email calls from application backend if false - No copilot backend impact - Turn off for on-prem no external email
VITE_SERVICES_EMAIL="true"
# services - nixtla - Toggles NIXTLA time-series forecasting features - If false, NIXTLA options hidden in UI - No NIXTLA calls from application backend if false - No copilot backend impact
VITE_SERVICES_NIXTLA="false"
# services - cloudflare_worker - Toggles Cloudflare Worker-based RSS proxy - If false, RSS proxy not available; RSS handled differently - No Cloudflare Worker calls from application backend if false - No copilot backend impact
VITE_SERVICES_CLOUDFLARE_WORKER="true"


# whitelabel config
# name that shows in title SEO tags and browser navbar + pwa name
VITE_WL_NAME="OpenBB Workspace"
# pwa specific field - shortname
VITE_WL_SHORT_NAME="OpenBB"
# image that shows on login/register. keep "/assets/images/openbb_terminal.svg" for openbb default. image will have max height 130px (can have any reasonable height) (e.g., https://brandlogos.net/wp-content/uploads/2021/11/bank_of_america-logo-512x512.png, data:image/svg+xml;base64,BASE64STRING)
VITE_WL_LOGIN_IMAGE="/assets/images/openbb_lettering.svg"
# image that shows on login/register on dark mode. keep "/assets/images/openbb_terminal_light.svg" for openbb default. image will have max height 130px (can have any reasonable height) (e.g., https://brandlogos.net/wp-content/uploads/2021/11/bank_of_america-logo-512x512.png, data:image/svg+xml;base64,BASE64STRING)
VITE_WL_LOGIN_IMAGE_DARK="/assets/images/openbb_lettering_light.svg"
# logo to show on top left corner of left sidebar. keep empty for openbb default. should be square (e.g., https://brandlogos.net/wp-content/uploads/2021/11/bank_of_america-logo-512x512.png)
VITE_WL_LEFT_SIDEBAR_LOGO=""
# logo to show on top left corner of left sidebar for dark mode. keep empty for openbb default. should be square (e.g., https://brandlogos.net/wp-content/uploads/2021/11/bank_of_america-logo-512x512.png)
VITE_WL_LEFT_SIDEBAR_LOGO_DARK=""
# favicon. keep /favicon/favicon.ico for openbb default. (e.g., https://www.bankofamerica.com/homepage/spa-assets/images/assets-images-global-favicon-favicon-CSX8d65d6e4.ico, data:image/x-icon;base64,BASE64STRING)
VITE_WL_FAVICON="/favicon/favicon.ico"
# seo tag for page description
VITE_WL_DESCRIPTION="OpenBB is the only open, AI-native workspace that unifies data, streamlines workflows, and delivers enterprise-grade collaboration and control for teams of all sizes."
# seo tag for keywords
VITE_WL_KEYWORDS="OpenBB Workspace, ai, finance, investment research, financial analysis, data visualization, teams, enterprise, collaborative platform, customizable research tools, financial technology, fintech, market insights"
# main color of the app, #0088CC for openbb default. should be a hex color (e.g., #3F51B5, #8F4B00)
VITE_WL_MAIN_COLOR="#0088CC"
# font family to be used, only Inter and Roboto are supported at the moment
VITE_WL_FONT_FAMILY="Inter"
# whitelabel branding - show floating menu for theme preview
VITE_WL_SHOW_FLOATING_THEME_PREVIEW="false"
