def print_import_instructions(
    archive: Path, email: str, with_files: bool = False
) -> None:
    """Print the steps to hand to the person receiving the archive.

    The same instructions ship inside the archive as README.md, but the operator
    passing the file on should not have to unzip it to find them.
    """
    name = archive.name
    print("-" * 72)
    print(f"  SEND THIS TO {email}")
    print("-" * 72)
    print(f"""
  Your OpenBB data is in {name}.

  To load it into OpenBB Lite:

    1. Start OpenBB Lite with the folder holding this file mounted:

       docker run -d --name openbb -p 3000:3000 \\
           -v openbb-data:/data \\
           -v /path/to/the/folder:/import \\
           openbb/lite

    2. Import it:

       docker exec openbb openbb-import /import/{name}

    3. Get the admin login and sign in at http://localhost:3000

       docker exec openbb credentials

    4. As the admin, set a password for {email}.
       Your old OpenBB password does not carry over -- it was never exported.

  Notes:""")
    if with_files:
        print(
            "    - Your uploaded files are in the archive's files/ folder. They are\n"
            "      NOT loaded into Lite, so unzip and keep them somewhere safe."
        )
    else:
        print(
            "    - This archive does not include your uploaded files, only the\n"
            "      record of them. Ask for an export with files if you need them."
        )
    print(
        "    - The archive holds your data connector credentials in the clear.\n"
        "      Keep it private and delete it once you have imported it."
    )
    print()
    print("-" * 72)


def user_export(args: argparse.Namespace) -> None:
    client = get_client()
