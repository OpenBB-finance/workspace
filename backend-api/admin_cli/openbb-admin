def auth_login(args: argparse.Namespace) -> None:
    cfg = load_config()
    base_url = args.api_url or cfg["base_url"]
    email = args.email or input("Email: ")
    password = args.password or getpass.getpass("Password: ")
    client = HubAPIClient(base_url)
    try:
        token = client.auth_login(email, password)
        save_config({"base_url": base_url, "access_token": token})
        if args.json:
            print(json.dumps({"success": True, "access_token": token}, indent=2))
        else:
            print("✓ Authenticated successfully")
    except APIError as e:
        handle_api_error(e)


def auth_logout(args: argparse.Namespace) -> None:
    if CONFIG_FILE.exists():
        CONFIG_FILE.unlink()

    print("✓ Logged out")


def auth_status(args: argparse.Namespace) -> None:
    cfg = load_config()
    authenticated = bool(cfg.get("access_token"))
    status = {
        "authenticated": authenticated,
        "base_url": cfg.get("base_url", ""),
        "access_token": (cfg["access_token"][:10] + "..." if authenticated else None),
    }

    fields = [
        ("Authenticated", "authenticated"),
        ("Base URL", "base_url"),
        ("Token", "access_token"),
    ]
    render_record(status, fields, args.json)


def entity_create(args: argparse.Namespace) -> None:
    client = get_client()
    try:
        data = get_config_json(args.config)
        resp = client.entity_create_with_entitlements(data)
        entity_uuid = resp.get("entity_uuid")
        if args.json:
            print(json.dumps(resp, indent=2))
        else:
            print(f"✓ Entity created: {entity_uuid}")
    except Exception as e:
        print(f"✗ Error: {e}", file=sys.stderr)
        sys.exit(1)


def entity_list(args: argparse.Namespace) -> None:
    client = get_client()
    try:
        resp = client.entity_list(args.page, args.size)
        render_list(
            resp,
            args.json,
            lambda i: (
                f"{i['uuid']} | "
                f"{get_val(i, 'entity_type.code')} | "
                f"{i['name']} | "
                f"{get_val(i, 'entity_type.entity_type')} | "
                f"{i.get('seats', 'N/A')} seats"
            ),
        )
    except APIError as e:
        handle_api_error(e)


