# RENDERING UTILITIES
# ============================================================================


def get_val(data: Dict[str, Any], path: str) -> str:
    """Get value from nested dict using dot notation"""
    parts = path.split(".")
    curr = data
    for p in parts:
        if isinstance(curr, dict):
            curr = curr.get(p, {})
        else:
            return "N/A"
    return str(curr) if curr is not None and curr != {} else "N/A"


def render_record(data: Dict[str, Any], fields: List[tuple], json_mode: bool) -> None:
    """Render a single record as Key-Value text or JSON"""
    if json_mode:
        print(json.dumps(data, indent=2))
        return

    width = max(len(f[0]) for f in fields)
    for label, path in fields:
        val = get_val(data, path)
        print(f"{label.ljust(width)} : {val}")


def render_list(
    response: Dict[str, Any],
    json_mode: bool,
    text_formatter: Any,
) -> None:
    """Render a list of items as formatted text rows or JSON"""
    if json_mode:
        print(json.dumps(response, indent=2))
        return

    items = response.get("items", [])
    if not items:
        print("No items found")
        return

    for item in items:
        print(text_formatter(item))


