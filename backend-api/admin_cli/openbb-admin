        # Compose primitives: lookup user + download their archive
        user = client.user_get_by_email(args.email)
        payload, suggested = client.user_export(
            user["uuid"],
            include_history=args.include_history,
            include_legacy=args.include_legacy,
            with_files=args.with_files,
        )
    except APIError as e:
        handle_api_error(e)
        return

    out = Path(args.out)
    if out.is_dir() or not out.suffix:
        out.mkdir(parents=True, exist_ok=True)
        out = out / (suggested or f"openbb-export-{user['uuid']}.zip")
    else:
        out.parent.mkdir(parents=True, exist_ok=True)
    out.write_bytes(payload)

    if args.json:
        print(json.dumps({"path": str(out), "bytes": len(payload)}, indent=2))
        return

    print(f"✓ Exported {args.email} to {out} ({len(payload) / 1024:.0f} KB)")
    print()
    print("  This archive contains unencrypted backend and copilot credentials.")
    print("  Treat it as a secret and delete it once it has been imported.")
    print()
