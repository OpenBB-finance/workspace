CONFIG_FILE = CONFIG_DIR / "config.json"
BASE_URL = os.getenv("OPENBB_BASE_URL", "https://localhost:8080")


class APIError(Exception):
    """Custom exception for API errors"""

    def __init__(self, status_code: int, message: str) -> None:
        self.status_code = status_code
        self.message = message
        super().__init__(f"API Error {status_code}: {message}")


ERROR_GUIDANCE = {
    403: {
        "Maximum seats reached": (
            "The entity has reached its seat limit.\n"
            "Fix: openbb-admin entity update <uuid> --data '{\"seats\": N}'"
        ),
    },
    404: {"default": "Resource not found. Check the UUID and try again."},
    409: {"default": "Conflict - resource already exists or duplicate detected."},
    422: {"default": "Validation error - check your input data."},
}


DEFAULT_ENTITLEMENT = {
    "tier": "pro",
    "number_copilot_calls_day": 10_000,
    "total_file_upload_size_gb": 10,
    "bundle_name": "On-Premise",
}


class HubAPIClient:
    """OpenBB Hub API client using stdlib only"""

    def __init__(self, base_url: str, access_token: Optional[str] = None) -> None:
        self.base_url = base_url.rstrip("/")
        self.access_token = access_token

    def _request(
        self,
        method: Literal["DELETE", "GET", "PATCH", "POST", "PUT"],
        endpoint: str,
        data: Optional[Dict[str, Any]] = None,
        params: Optional[Dict[str, Any]] = None,
    ) -> Dict[str, Any]:
        """Make HTTP request with error handling and retries"""
        url = f"{self.base_url}{endpoint}"

        if params:
            query_string = urllib.parse.urlencode(params)
            url = f"{url}?{query_string}"

        headers = {
            "Content-Type": "application/json",
            "User-Agent": f"openbb-admin/{VERSION}",
        }

        if self.access_token:
            headers["Authorization"] = f"Bearer {self.access_token}"

        logger.debug(f"{method} {url}")
        logger.debug(f"Headers: {json.dumps(headers, default=str)}")
        if data:
            logger.debug(f"Payload: {json.dumps(data, indent=2)}")

        req_data = json.dumps(data).encode("utf-8") if data else None
        request = urllib.request.Request(
            url, data=req_data, headers=headers, method=method
        )

        retries = 3
        backoff = 1

        for attempt in range(retries):
            try:
                with urllib.request.urlopen(request, timeout=30) as response:
                    response_data = response.read().decode("utf-8")
                    return json.loads(response_data) if response_data else {}
            except urllib.error.HTTPError as e:
                error_body = e.read().decode("utf-8")
                try:
                    error_data = json.loads(error_body)
                    raise APIError(e.code, error_data.get("detail", error_body))
                except json.JSONDecodeError:
                    raise APIError(e.code, error_body)
            except urllib.error.URLError as e:
                if attempt < retries - 1:
                    time.sleep(backoff)
                    backoff *= 2
                    continue
                raise APIError(0, f"Network error: {e.reason}")
            except Exception as e:
                if attempt < retries - 1:
                    time.sleep(backoff)
                    backoff *= 2
                    continue
                raise APIError(0, f"Unexpected error: {str(e)}")
        return {}

    def _request_binary(
        self,
        method: Literal["GET", "POST"],
        endpoint: str,
        params: Optional[Dict[str, Any]] = None,
    ) -> Tuple[bytes, str]:
        """Fetch a binary response body. Returns (payload, suggested filename).

        Separate from _request because that one decodes UTF-8 and parses JSON,
        which would corrupt a zip. No retry loop here either: these responses
        can be large, and silently re-downloading is worse than reporting the
        failure.
        """
        url = f"{self.base_url}{endpoint}"
        if params:
            url = f"{url}?{urllib.parse.urlencode(params)}"

        headers = {"User-Agent": f"openbb-admin/{VERSION}"}
        if self.access_token:
            headers["Authorization"] = f"Bearer {self.access_token}"

        logger.debug(f"{method} {url}")
        request = urllib.request.Request(url, headers=headers, method=method)

        try:
            with urllib.request.urlopen(request, timeout=600) as response:
                payload = response.read()
                disposition = response.headers.get("Content-Disposition", "")
                filename = ""
                if "filename=" in disposition:
                    filename = disposition.split("filename=", 1)[1].strip().strip('"')
                return payload, filename
        except urllib.error.HTTPError as e:
            error_body = e.read().decode("utf-8", errors="replace")
            try:
                raise APIError(e.code, json.loads(error_body).get("detail", error_body))
            except json.JSONDecodeError:
                raise APIError(e.code, error_body)
        except urllib.error.URLError as e:
            raise APIError(0, f"Network error: {e.reason}")

    # AUTH
    def auth_login(self, email: str, password: str) -> str:
        data = {
            "email": email,
            "password": password,
            "remember": False,
            "ip_address": "",
            "source": "pro",
            "totp_token": None,
        }
        response = self._request("POST", "/pro/login", data)
        return str(response["access_token"])

    # ENTITY
    def entity_create(self, data: Dict[str, Any]) -> Dict[str, Any]:
        # Compatibility mapping for create
        if "entity_type_uuid" in data and "entity_code" not in data:
            data["entity_code"] = data.pop("entity_type_uuid")
        return self._request("POST", "/entity/entity", data)

    def entity_entitlements_update(self, entity_uuid: str) -> Dict[str, Any]:
        return self._request(
            "PATCH",
            f"/entity/entitlement/{entity_uuid}",
            DEFAULT_ENTITLEMENT,
            {"update_all": True},
        )

    def entity_create_with_entitlements(self, data: Dict[str, Any]) -> Dict[str, Any]:
        """
        Create entity and auto-configure default entitlements.

        Args:
            data: Entity configuration dict

        Returns:
            Entity response dict (without permission_map_uuid key)

        Raises:
            APIError: If creation or entitlements update fails
        """
        e_resp = self.entity_create(data)
        entity_uuid = e_resp.get("entity_uuid")

        # Remove permission_map_uuid (internal implementation detail)
        e_resp.pop("permission_map_uuid", None)

        # Auto-configure entitlements
        self.entity_entitlements_update(entity_uuid)

        return e_resp

    def entity_list(self, page: int = 1, size: int = 100) -> Dict[str, Any]:
        return self._request(
            "GET", "/entity/entity", params={"page": page, "size": size}
        )

    def entity_get(self, entity_uuid: str) -> Dict[str, Any]:
        page = 1
        while True:
            entities = self.entity_list(page=page, size=100)
            for item in entities.get("items", []):
                if item.get("uuid") == entity_uuid:
                    return item
            total_pages = entities.get("pages")
            if total_pages is None or page >= total_pages:
                break
            page += 1
        raise APIError(404, f"Entity {entity_uuid} not found")

    def entity_update(self, entity_uuid: str, **kwargs: Any) -> Dict[str, Any]:
        """Smart partial update: Fetch -> Merge -> Transform -> Put"""
        current = self.entity_get(entity_uuid)

        # 1. Map GET structure to PUT structure
        entity_code = None
        et = current.get("entity_type")
        if isinstance(et, dict):
            entity_code = et.get("uuid")

        payload: Dict[str, Any] = {
            "name": current.get("name"),
            "entity_code": entity_code,
            "email": current.get("email"),
            "company_type": current.get("company_type"),
            "organization_size": current.get("organization_size"),
            "aum": current.get("aum"),
            "country": current.get("country"),
            "seats": current.get("seats"),
            "expiration_date": current.get("expiration_date"),
        }

        # 2. Merge user changes (ignore unknown keys)
        if "entity_type_uuid" in kwargs and "entity_code" not in kwargs:
            kwargs["entity_code"] = kwargs.get("entity_type_uuid")
        if "entity_type" in kwargs and "entity_code" not in kwargs:
            et_arg = kwargs.get("entity_type")
            if isinstance(et_arg, dict):
                kwargs["entity_code"] = et_arg.get("uuid")

        for key in payload:
            if key in kwargs:
                payload[key] = kwargs[key]

        # 3. PUT full payload
        return self._request("PUT", f"/entity/entity/{entity_uuid}", payload)

    def entity_remove(self, entity_uuid: str) -> Dict[str, Any]:
        return self._request("DELETE", f"/entity/entity/{entity_uuid}")

    # ENTITY TYPE
    def entity_type_create(self, name: str, code: str) -> Dict[str, Any]:
        data = {
            "entity_type": name,
            "code": code,
            "active": True,
            "permission_hierarchy": 0,
        }
        return self._request("POST", "/entity/entity-type", data)

    def entity_type_list(self, page: int = 1, size: int = 100) -> Dict[str, Any]:
        return self._request(
            "GET", "/entity/entity-type", params={"page": page, "size": size}
        )

    # PERMISSION MAPS
    def permission_map_list(
        self,
        entity_uuid: Optional[str] = None,
    ) -> List[Dict[str, Any]]:
        """
        List permission maps, optionally filtered by entity.

        Iterates through all pages to find maps for the specified entity.
        For a specific entity, expects to find 2 maps (Admin + User).
        """
        all_items: List[Dict[str, Any]] = []
        page = 1

        while True:
            response = self._request(
                "GET", "/entity/entity-map", params={"size": 100, "page": page}
            )
            items = response.get("items", [])

            if entity_uuid:
                # Filter for this entity
                matching = [
                    item for item in items if item["entity_uuid"] == entity_uuid
                ]
                all_items.extend(matching)
                # Entities have 2 permission maps (Admin + User), stop when we have both
                if len(all_items) >= 2:
                    break
            else:
                all_items.extend(items)

            # Check if there are more pages
            total_pages = response.get("pages", 1)
            if page >= total_pages:
                break
            page += 1

        return all_items

    def get_permission_map_by_role(self, entity_uuid: str, role: str) -> Dict[str, Any]:
        """
        Get permission map for entity by role name.

        Args:
            entity_uuid: Entity UUID
            role: Role name ('admin' or 'user', case-insensitive)

        Returns:
            Permission map dict with keys: uuid, name, entity_uuid

        Raises:
            APIError: If permission map not found for role
        """
        maps = self.permission_map_list(entity_uuid)
        role_name = "Admin" if role.lower() == "admin" else "User"
        p_map = next((m for m in maps if m["name"] == role_name), None)

        if not p_map:
            raise APIError(
                404, f"Permission map '{role_name}' not found for entity {entity_uuid}"
            )

        return p_map

    # USER
    def user_create(
        self,
        entity_uuid: str,
        email: str,
        first_name: str,
        last_name: str,
        role: str = "user",
        permissions_uuid: Optional[str] = None,
    ) -> Dict[str, Any]:
        """
        Create user in entity with specified role.

        Args:
            entity_uuid: Entity UUID
            email: User email
            first_name: User first name
            last_name: User last name
            role: Role name ('admin' or 'user', default: 'user')
            permissions_uuid: Optional permission map UUID (skips lookup if provided)

        Returns:
            User creation response with email and role added

        Raises:
            APIError: If permission map not found or user creation fails
        """
        # Lookup permission map from role if not provided
        if not permissions_uuid:
            p_map = self.get_permission_map_by_role(entity_uuid, role)
            permissions_uuid = p_map["uuid"]

        # Call backend API with low-level parameters
        resp = self._request(
            "POST",
            "/admin/create-user",
            {
                "email": email,
                "permissions_uuid": permissions_uuid,
                "first_name": first_name,
                "last_name": last_name,
            },
        )

        # Add friendly metadata to response
        resp["email"] = email
        resp["role"] = role

        return resp

    def user_list(
        self,
        page: int = 1,
        size: int = 100,
        email: Optional[str] = None,
    ) -> Dict[str, Any]:
        params: Dict[str, Any] = {"page": page, "size": size}
        if email:
            params["email"] = email
        return self._request("GET", "/entity/user", params=params)

    def user_get_by_email(self, email: str) -> Dict[str, Any]:
        """
        Get user by email address.

        Args:
            email: User email address

        Returns:
            User dict with keys: uuid, email, first_name, last_name, entity_uuid

        Raises:
            APIError: If user not found
        """
        resp = self.user_list(email=email)
        items = resp.get("items", [])

        if not items:
            raise APIError(404, f"User {email} not found")

        return items[0]

    def user_delete(self, user_uuid: str) -> Dict[str, Any]:
        return self._request("DELETE", f"/admin/users/{user_uuid}/remove")

    def user_reset_password(self, user_uuid: str) -> Dict[str, Any]:
        return self._request("POST", f"/admin/reset-password/{user_uuid}")

    def user_export(
        self,
        user_uuid: str,
        include_history: bool = False,
        include_legacy: bool = False,
        with_files: bool = False,
    ) -> Tuple[bytes, str]:
        """Download a user's data archive. Returns (zip bytes, filename)."""
        params: Dict[str, Any] = {}
        if include_history:
            params["include_history"] = "true"
        if include_legacy:
            params["include_legacy"] = "true"
        if with_files:
            params["with_files"] = "true"
        return self._request_binary(
            "POST", f"/admin/users/{user_uuid}/export", params=params or None
        )

    def user_update_entity(
        self, user_uuid: str, permissions_uuid: str
    ) -> Dict[str, Any]:
        return self._request(
            "PUT",
            f"/entity/user/{user_uuid}",
            {"permissions_uuid": permissions_uuid},
        )

    # DATA BACKENDS
    def data_backend_add(
        self,
        entity_uuid: str,
        name: str,
        url: str,
        endpoint_headers: Optional[List[Dict[str, str]]] = None,
    ) -> Dict[str, Any]:
        data: Dict[str, Any] = {"name": name, "url": url}
        if endpoint_headers:
            data["endpointHeaders"] = endpoint_headers
        return self._request("POST", f"/entity/data-backends/{entity_uuid}", data)

    def data_backend_delete(
        self, entity_uuid: str, backend_name: str
    ) -> Dict[str, Any]:
        return self._request(
            "DELETE", f"/entity/data-backends/{entity_uuid}/{backend_name}"
        )

    def data_backend_list(self, entity_uuid: str) -> Any:
        return self._request("GET", f"/entity/data-backends/{entity_uuid}")

    # ENTITLEMENTS
    def entitlement_update(
        self, entity_uuid: str, data: Dict[str, Any]
    ) -> Dict[str, Any]:
        return self._request(
            "PATCH",
            f"/entity/entitlement/{entity_uuid}",
            data,
            {"update_all": True},
        )

    def provision_full(self, config: Dict[str, Any]) -> Dict[str, Any]:
        """
        Execute complete provisioning workflow: entity + users.

        Args:
            config: Provisioning config dict with keys:
                - entity: Entity configuration
                - users: List of user dicts (email, first_name, last_name, role)

        Returns:
            Results dict with keys:
                - entity: Entity response
                - users: List of user responses
                - failed_users: List of dicts with email and error message

        Raises:
            APIError: If entity creation fails (user failures are collected, not raised)
        """
        results: Dict[str, Any] = {
            "entity": None,
            "users": [],
            "failed_users": [],
        }

        # Step 1: Create entity with entitlements
        entity_resp = self.entity_create_with_entitlements(config["entity"])
        results["entity"] = entity_resp
        entity_uuid = entity_resp["entity_uuid"]

        # Step 2: Fetch permission maps once (with retry for eventual consistency)
        permission_maps: Dict[str, str] = {}
        max_retries = 3
        for attempt in range(max_retries):
            maps = self.permission_map_list(entity_uuid)
            for m in maps:
                permission_maps[m["name"]] = m["uuid"]
            # We expect both Admin and User maps
            if "Admin" in permission_maps and "User" in permission_maps:
                break
            # Wait a bit for eventual consistency
            if attempt < max_retries - 1:
                time.sleep(0.5)

        # Step 3: Create users using cached permission maps
        for user_cfg in config.get("users", []):
            try:
                role = user_cfg.get("role", "user")
                role_name = "Admin" if role.lower() == "admin" else "User"
                perm_uuid = permission_maps.get(role_name)

                if not perm_uuid:
                    raise APIError(
                        404,
                        f"Permission map '{role_name}' not found for entity {entity_uuid}",
                    )

                resp = self.user_create(
                    entity_uuid=entity_uuid,
                    email=user_cfg["email"],
                    first_name=user_cfg["first_name"],
                    last_name=user_cfg["last_name"],
                    role=role,
                    permissions_uuid=perm_uuid,
                )
                results["users"].append(resp)
            except APIError as e:
                results["failed_users"].append(
                    {"email": user_cfg["email"], "error": str(e)}
                )

        return results


