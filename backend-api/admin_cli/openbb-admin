def provision_check(args: argparse.Namespace) -> None:
    """Validate provisioning configuration schema locally"""
    try:
        data = get_config_json(args.config)

        errors = []

        # Validate Entity
        if "entity" not in data:
            errors.append("Missing top-level 'entity' object")
        else:
            required_entity = [
                "name",
                "entity_type_uuid",
                "email",
                "company_type",
                "organization_size",
                "aum",
                "country",
                "seats",
                "expiration_date",
                "admin_email",
            ]
            for field in required_entity:
                if field not in data["entity"]:
                    errors.append(f"Entity missing required field: {field}")

        # Validate Users (Optional)
        roles = {"admins": data.get("admins", []), "users": data.get("users", [])}
        for role, users in roles.items():
            for idx, user in enumerate(users):
                for field in ["email", "first_name", "last_name"]:
                    if field not in user:
                        errors.append(f"User ({role} #{idx}) missing field: {field}")

        if errors:
            if args.json:
                print(json.dumps({"valid": False, "errors": errors}, indent=2))
            else:
                print("✗ Configuration invalid:")
                for err in errors:
                    print(f"  - {err}")
            sys.exit(1)

        if args.json:
            print(json.dumps({"valid": True}, indent=2))
        else:
            print("✓ Configuration is valid")

    except json.JSONDecodeError as e:
        if args.json:
            print(
                json.dumps({"valid": False, "errors": [f"Invalid JSON: {e}"]}, indent=2)
            )
        else:
            print(f"✗ Invalid JSON file: {e}", file=sys.stderr)
        sys.exit(1)
    except FileNotFoundError:
        if args.json:
            print(json.dumps({"valid": False, "errors": ["File not found"]}, indent=2))
        else:
            print(f"✗ File not found: {args.config}", file=sys.stderr)
        sys.exit(1)


