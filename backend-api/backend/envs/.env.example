# OpenBB Payments Backend Configuration
# ⚠️ MIGHT CONTAIN SENSITIVE INFORMATION - DO NOT SHARE ⚠️

### DATABASE CONFIG ###
# Database type (mysql/postgresql/sqlite)
DATABASE_TYPE=mysql

# --- MySQL/PostgreSQL settings ---
# Database host
DB_HOST=mysql # For local debug (i.e., docker-compose-local-dev.yml), you need to set the DB_HOST to "localhost"
# Database port
DB_PORT=3306
# Database name
DB_NAME=sample_db
# Database read user
READ_DB_USER=root
# Database read password
READ_DB_PASSWORD=root
# Database write user
WRITE_DB_USER=root
# Database write password
WRITE_DB_PASSWORD=root
# SSL Certificate Authority file path (optional)
SSL_CA=/path/to/ca.pem
# SSL Client Certificate file path (optional)
SSL_CERT=/path/to/client-cert.pem
# SSL Client Key file path (optional)
SSL_KEY=/path/to/client-key.pem

# --- SQLite settings (used when DATABASE_TYPE=sqlite) ---
# File path for the SQLite database
# DB_PATH=/data/openbb.db
### DATABASE CONFIG END ###

### REDIS CONFIG ###
# Redis host
REDIS_HOST=redis # localhost # For local debug (i.e., docker-compose-local-dev.yml), you need to set the REDIS_HOST to "localhost"
# Redis username (Optional - leave empty if not used)
REDIS_USER=
# Redis password
REDIS_PASS=
# Redis port
REDIS_PORT=6379
# Redis Cluster Mode (set to 1 for cluster mode, 0 for single-node)
REDIS_CLUSTER_MODE=0
# Set REDIS_RQ_HASH_TAGS to work with sharded redis that does not expose cluster endpoints
REDIS_RQ_HASH_TAGS=0
### REDIS CONFIG END ###

### HUBSPOT CONFIG ###
# Hubspot enabled/disabled
HUBSPOT=1
# Hubspot email token
HUBSPOT_EMAIL_TOKEN=pat-hubspot-email-token
# Hubspot contact token
HUBSPOT_CONTACT_TOKEN=pat-hubspot-contact-token
# Hubspot service token
HUBSPOT_SERVICE_TOKEN=pat-hubspot-service-token
### HUBSPOT CONFIG END ###

### JIRA SERVICE MANAGEMENT CONFIG ###
# Jira enabled/disabled (can be used to toggle provider, or use FEEDBACK_PROVIDER below)
FEEDBACK_PROVIDER=jira
# Jira base URL (e.g. https://your-domain.atlassian.net)
JIRA_BASE_URL=https://your-domain.atlassian.net
# Jira service account email
JIRA_USER_EMAIL=service-account@example.com
# Jira service account API token
JIRA_API_TOKEN=pat-jira-api-token
# Jira Service Desk ID
JIRA_SERVICE_DESK_ID=2
# Jira Default Request Type ID for feedback (fallback)
JIRA_DEFAULT_REQUEST_TYPE_ID=46
# JSON mapping of frontend ticket types to Jira Request Type IDs
JIRA_REQUEST_TYPE_MAPPING='{"bug": "4", "feature": "7", "feedback": "45"}'
### JIRA SERVICE MANAGEMENT CONFIG END ###

### PROMETHEUS CONFIG ###
# Prometheus enabled/disabled
PROMETHEUS=1
### PROMETHEUS CONFIG END ###

### S3 CONFIG ###
# Storage provider (aws/azure/gcp)
STORAGE_PROVIDER=aws
# S3 access key
S3_ACCESS_KEY=pat-s3-access-key
# S3 secret key
S3_SECRET_KEY=pat-s3-secret-key
# S3 bucket name
S3_BUCKET_NAME=pat-s3-bucket-name
# S3 file bucket name
S3_FILE_BUCKET=pat-s3-file-bucket
# S3 region (optional - e.g., us-east-1, ca-central-1)
S3_REGION=
# S3 endpoint URL
S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3 verify SSL (optional - set to 1 to force SSL verification)
S3_VERIFY_SSL=0
# S3 signature version (s3v4 or v4; optional - defaults to s3v4)
S3_SIGNATURE_VERSION=s3v4
### S3 CONFIG END ###

# Azure Storage configuration (used when STORAGE_PROVIDER=azure)
# AZURE_STORAGE_ACCOUNT=your-storage-account
# AZURE_STORAGE_CONTAINER=your-container
# AZURE_CONNECTION_STRING=your-storage-key
### STORAGE CONFIG END ###

### API CONFIG ###
# API mode
MODE=test
# Suppressed API routers
SUPPRESSED_API_ROUTERS=["bot", "terminal", "sdk", "run_tasks", "testing", "metrics"]
# Suppressed API routes
SUPPRESSED_API_ROUTES=["/feedback", "/stripe", "/stripe/webhook", "/invite-emails", "/metrics/users"]
# Stripe webhook secret (whsec_...) from the Stripe dashboard endpoint. Leave unset
# to disable the /stripe/webhook endpoint (it will return 503).
# below is the dev secret for the stripe webhook
STRIPE_WEBHOOK_SECRET=whsec_03891367614af2d2555b4ce97dcbd52aad7ed980d449fa2ee5fe736228f9abec
# STRIPE_WEBHOOK_SECRET=whsec_b8qAkTt3BI5ZxG3g3PfHptbApxBOZgKC
# Max age in seconds for a Stripe-Signature timestamp before we reject the event.
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Private lambda that provisions ECR access and returns the install JSON. Invoked
# via the AWS SDK (pod IAM role needs lambda:InvokeFunction on it); no URL. Set
# empty to record the user but skip provisioning + install email.
LITE_LAMBDA_FUNCTION_NAME=lite-onboarding-lambda
# Docker tag rendered into the install email. Bump per Lite release.
OPENBB_LITE_DOCKER_TAG=0.0.3
# Disable new user registration. When set to 1, every path that creates a user
# returns 403 "Registration is disabled": POST /register, POST /pro/register,
# POST /admin/register, POST /entity/register-admin, and the pro invite flow.
# POST /pro/create-user/{uuid} redirects to the login page with
# ?error=registration+is+disabled instead, and the newsletter signup is skipped.
# Existing users can still log in and use the app as normal. Set this for
# on-prem or closed deployments where accounts are provisioned out of band.
# Read once at startup - restart the app (or the pod) after you change it.
DISABLE_REGISTRATION=0
# Disable CORS
DISABLE_CORS=1
# Backend CORS origins - when `DISABLE_CORS=0`, the application will pick up the origins from `utilities.config.py` - adding origins here will override the defaults defined there
BACKEND_CORS_ORIGINS=["https://pro.openbb.co"]
# Number of workers
WORKERS=1
# Port to run on default is 8000
#PORT=8000
### API CONFIG END ###

### OpenBB configurations ###
# JWT secret - used for JWT tokens
JWT_SECRET=pat-jose-secret
# OpenBB auth token - used for authentication
OPENBB_AUTH_TOKEN=pat-openbb-auth-token
# Frontend URL - used for redirecting on emails
FRONTENDURL=http://127.0.0.1 # https://my.openbb.dev
# Self URL - used to generate URLs for files, check rate limits, etc.
SELFURL=http://127.0.0.1:8000 # https://payments.openbb.dev
# Pro URL - used for redirecting on emails and trial extension emails
PROURL=http://localhost:1420 # https://pro.openbb.dev
# Frontend user agent - used to exempt frontend from rate limiting
OPENBB_FRONTEND_USER_AGENT=colinlovedrust
# AI user agent
OPENBB_AI_USER_AGENT=copilotmoonsatnoon
# Geo key - used to get IP information
OPENBB_GEO_KEY=pat-geo-key
# AES key - used for encrypting and decrypting data - should never change once set
OPENBB_AES_KEY=pat-aes-key
# OKTA DOMAIN - used for OKTA authentication
OKTA_DOMAIN=dev-123456.okta.com
### OpenBB configurations END ###
