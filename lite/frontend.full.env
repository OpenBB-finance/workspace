# Vite build-time env for the full terminalpro build.
#
# Runtime values are still rendered by render-frontend-config.full.sh at
# container start. These values satisfy the Vite schema and provide fallback
# defaults in dist/config.js.

VITE_PAYMENTS_URL="/api"
VITE_AI_API_URL=""
VITE_PLATFORM_URL=""
VITE_DATABASE_API_URL=""

VITE_LITE="false"
VITE_UI_SHOW_MARKETPLACE="true"

VITE_AUTHENTICATION_ALLOW_EMAIL_LOGIN="true"
VITE_AUTHENTICATION_ALLOW_REGISTRATION="false"
VITE_AUTHENTICATION_ALLOW_FORGOT_PASSWORD="false"
VITE_AUTHENTICATION_IDENTITY_PROVIDERS=""
VITE_AUTHENTICATION_SEND_MICROSOFT_IDTOKEN="false"
VITE_AUTHENTICATION_SEND_OKTA_IDTOKEN="false"
VITE_AUTHENTICATION_SEND_USER_EMAIL_AS_HEADER="false"

VITE_GOOGLE_OAUTH_CLIENT_ID=""
VITE_AZURE_CLIENT_ID=""
VITE_AZURE_TENANT_ID=""
VITE_OKTA_CLIENT_ID=""
VITE_OKTA_DOMAIN=""

VITE_AI_COPILOT_ENABLED="true"
VITE_AI_COPILOT_OPENBB_COPILOT="false"
VITE_AI_COPILOT_DOCUMENTATION_LINKS="true"
VITE_AI_COPILOT_WEB_SEARCH="true"
VITE_AI_COPILOT_SEC_FILINGS="true"
VITE_AI_COPILOT_JINA_AI="true"
VITE_AI_COPILOT_AI_ENHANCEMENTS="true"
VITE_AI_SHOW_CUSTOM_COPILOT_KEY="true"

VITE_UI_SHOW_COMPANION_MCP_MODE="true"
VITE_UI_SHOW_MINIMIZE_WIDGET="true"
VITE_UI_SHOW_CHART_GENERATION="true"
VITE_UI_SHOW_FEEDBACK_BUTTON="false"
VITE_UI_SHOW_INVITE_BUTTON="false"
VITE_UI_SHOW_DEMO_REQUEST_BUTTON="false"
VITE_UI_SHOW_ENTERPRISE_TAGS="false"
VITE_UI_SHOW_EXTERNAL_DOCUMENTATION_LINKS="true"
VITE_UI_SHOW_HELP_DOCUMENTATION="true"
VITE_UI_SHOW_CHANGELOG="true"
VITE_UI_SHOW_ONBOARDING_QUESTIONS="false"
VITE_UI_SHOW_TOS="false"
VITE_UI_SHOW_COPILOT_SWITCHER="true"
VITE_UI_SHOW_REMOVE_FROM_ORG="true"
VITE_UI_DEFAULT_THEME="dark"
VITE_UI_ODP_DOWNLOAD_INSTALLER="false"
VITE_UI_SHOW_SALES_EMAIL="false"

VITE_SERVICES_POSTHOG="false"
VITE_SERVICES_HUBSPOT_FORMS="false"
VITE_SERVICES_EMAIL="false"
VITE_SERVICES_NIXTLA="false"
VITE_SERVICES_CLOUDFLARE_WORKER="false"

VITE_DATA_PACKAGE_DATA_ENABLED="true"
VITE_DATA_ALLOWED_DATA_VENDORS=""
VITE_DATA_ALLOWED_DB_TYPES="database,snowflake,databricks,clickhouse"
VITE_OPEN_DATA_PLATFORM_INSTALLER_ENABLED="false"
VITE_ALLOW_HTML_JS_EXECUTION="true"

VITE_MCP_DEFAULT_SERVER_ENABLED="true"

VITE_POSTHOG_KEY=""
VITE_POSTHOG_URL=""

VITE_WL_NAME="OpenBB"
VITE_WL_SHORT_NAME="OpenBB"
VITE_WL_LOGIN_IMAGE="/assets/images/openbb_lettering.svg"
VITE_WL_LOGIN_IMAGE_DARK="/assets/images/openbb_lettering_light.svg"
VITE_WL_LEFT_SIDEBAR_LOGO=""
VITE_WL_LEFT_SIDEBAR_LOGO_DARK=""
VITE_WL_FAVICON="/favicon/favicon.ico"
VITE_WL_DESCRIPTION="OpenBB workspace."
VITE_WL_KEYWORDS="OpenBB, finance, workspace"
VITE_WL_MAIN_COLOR="#0088CC"
VITE_WL_FONT_FAMILY="Inter"
VITE_WL_SHOW_FLOATING_THEME_PREVIEW="false"

VITE_DATA_CONNECTOR_MIN_VERSION="0.1.1"
