# Vite build-time env for the OpenBB Lite terminalpro build.
#
# These values are only used to satisfy the Zod schema during
# `npm run build:runtime` and to write a fallback dist/config.js. At container
# start /entrypoint.sh re-renders /usr/share/nginx/html/config.js from real
# runtime env vars (see render-frontend-config.sh), so anything you put here
# can be overridden at `docker run` time.
#
# Only operator-overridable ("_unlocked") fields are listed. Everything else is
# bundle-locked by the Lite profile — a VITE_* value for a locked field would
# be dead config (the locked value always wins), so those lines are
# intentionally absent.

# URLs — relative paths so the SPA hits the nginx-proxied backend on the same
# origin and port the user maps.
VITE_PAYMENTS_URL="/api"
VITE_AI_API_URL=""
VITE_PLATFORM_URL=""
VITE_DATABASE_API_URL=""

# Lock policy: the strict in-repo profile terminalpro/config-profiles/lite.locked.json.
# Every field it locks is baked into the JS bundle at build time and forcibly
# overrides config.js / window.__APP_CONFIG__ at runtime — those are the values
# a Lite operator can never change. Its "_unlocked" list is what
# render-frontend-config.sh exposes as runtime-overridable.
VITE_LOCKED_CONFIG_PROFILE="lite"

# Build-time fallbacks for the overridable fields.
VITE_AUTHENTICATION_SEND_USER_EMAIL_AS_HEADER="false"

VITE_AI_COPILOT_ENABLED="false"
VITE_AI_COPILOT_OPENBB_COPILOT="false"
VITE_AI_COPILOT_AI_ENHANCEMENTS="true"

VITE_UI_SHOW_COMPANION_MCP_MODE="false"
VITE_UI_SHOW_MINIMIZE_WIDGET="true"
VITE_UI_SHOW_CHART_GENERATION="true"
VITE_UI_SHOW_CHANGELOG="false"
VITE_UI_SHOW_COPILOT_SWITCHER="false"
VITE_UI_SHOW_MARKETPLACE="true"

VITE_MCP_DEFAULT_SERVER_ENABLED="false"
VITE_ALLOW_HTML_JS_EXECUTION="false"

# VITE_RELEASE_VERSION is intentionally absent — the Dockerfile carries it
# over from terminalpro's .env so the sidebar shows the real release version.
VITE_DATA_CONNECTOR_MIN_VERSION="0.1.1"
